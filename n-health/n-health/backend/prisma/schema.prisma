// N-Health database schema
// Covers all 6 roles: Patient, Doctor, Pharmacy, Lab, Ambulance, Nurse

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  PHARMACY
  LAB
  AMBULANCE
  NURSE
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AppointmentType {
  IN_PERSON
  VIDEO
}

enum OrderStatus {
  PENDING
  PROCESSING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum LabTestStatus {
  REQUESTED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum EmergencyStatus {
  REQUESTED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  COMPLETED
  CANCELLED
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum NurseRequestStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  USSD
  TRANSFER
  CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
  FAILED
}

// What a Payment is paying for. Kept as a loose (non-FK) reference via
// payableType + payableId since Prisma has no native polymorphic relations -
// this lets one Payment model serve every module instead of duplicating
// payment fields on Appointment, PharmacyOrder, LabTest, etc.
enum PayableType {
  APPOINTMENT
  PHARMACY_ORDER
  LAB_TEST
  NURSE_REQUEST
  DONATION
  INSURANCE_POLICY
}

// ============ CORE USER ============

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role
  name         String
  avatarUrl    String?
  isActive     Boolean  @default(true)
  // Only meaningful when role = ADMIN. A super admin can create/manage other
  // admin accounts; a regular admin cannot - this is what "super admin panel"
  // gates access to versus the plain admin views.
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile   PatientProfile?
  doctorProfile    DoctorProfile?
  pharmacyProfile  PharmacyProfile?
  labProfile       LabProfile?
  ambulanceProfile AmbulanceProfile?
  nurseProfile     NurseProfile?

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  payments         Payment[] @relation("PayerPayments")
  confirmedPayments Payment[] @relation("ConfirmedPayments")

  adminActions     AdminAuditLog[] @relation("AdminActions")

  @@index([role])
}

// ============ ROLE PROFILES ============

model PatientProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth       DateTime?
  bloodType         String?
  genotype          String?
  nhisNumber        String?
  allergies         String?
  address           String?
  emergencyContact  String?
  emergencyPhone    String?

  appointments      Appointment[]
  prescriptions     Prescription[]
  orders            PharmacyOrder[]
  labTests          LabTest[]
  emergencyRequests EmergencyRequest[]
  donations         Donation[]
  insurancePolicies InsurancePolicy[]
  nurseRequests     NurseRequest[]
}

model DoctorProfile {
  id                String  @id @default(uuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty         String
  licenseNumber     String
  hospital          String?
  bio               String?
  consultationFee   Decimal @default(0)
  rating            Float   @default(0)
  yearsExperience   Int     @default(0)
  lat               Float?
  lng               Float?

  appointments  Appointment[]
  prescriptions Prescription[]
  reviewedLabResults LabResult[]
}

model PharmacyProfile {
  id             String @id @default(uuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacyName   String
  licenseNumber  String
  address        String?
  operatingHours String?
  lat            Float?
  lng            Float?

  inventory Inventory[]
  orders    PharmacyOrder[]
  suppliers Supplier[]
}

model LabProfile {
  id            String @id @default(uuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  labName       String
  licenseNumber String
  address       String?
  lat           Float?
  lng           Float?

  labTests LabTest[]
}

model AmbulanceProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleNumber String
  licenseNumber String
  currentLat    Float?
  currentLng    Float?
  isAvailable   Boolean  @default(true)

  emergencyRequests EmergencyRequest[]
}

model NurseProfile {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber String
  specialty     String?
  hourlyRate    Decimal @default(0)
  isAvailable   Boolean @default(true)

  nurseRequests NurseRequest[]
}

// ============ APPOINTMENTS & PRESCRIPTIONS ============

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  patient     PatientProfile    @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      DoctorProfile     @relation(fields: [doctorId], references: [id])
  scheduledAt DateTime
  type        AppointmentType   @default(IN_PERSON)
  status      AppointmentStatus @default(PENDING)
  reason      String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([patientId])
  @@index([doctorId])
}

model Prescription {
  id         String   @id @default(uuid())
  patientId  String
  patient    PatientProfile @relation(fields: [patientId], references: [id])
  doctorId   String
  doctor     DoctorProfile  @relation(fields: [doctorId], references: [id])
  medications Json    // [{ name, dosage, frequency, durationDays }]
  status     String   @default("ACTIVE")
  issuedAt   DateTime @default(now())
  orders     PharmacyOrder[]
}

// ============ PHARMACY ============

model Inventory {
  id         String   @id @default(uuid())
  pharmacyId String
  pharmacy   PharmacyProfile @relation(fields: [pharmacyId], references: [id])
  name       String
  category   String?
  stock      Int      @default(0)
  price      Decimal
  expiryDate DateTime?
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([pharmacyId])
}

model Supplier {
  id         String @id @default(uuid())
  pharmacyId String
  pharmacy   PharmacyProfile @relation(fields: [pharmacyId], references: [id])
  name       String
  contact    String?
  email      String?

  items Inventory[]
}

model PharmacyOrder {
  id             String      @id @default(uuid())
  patientId      String
  patient        PatientProfile @relation(fields: [patientId], references: [id])
  pharmacyId     String
  pharmacy       PharmacyProfile @relation(fields: [pharmacyId], references: [id])
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  items          Json        // [{ inventoryId, name, qty, price }]
  total          Decimal
  status         OrderStatus @default(PENDING)
  paymentStatus  String      @default("PENDING")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([patientId])
  @@index([pharmacyId])
}

// ============ LAB ============

model LabTest {
  id          String        @id @default(uuid())
  patientId   String
  patient     PatientProfile @relation(fields: [patientId], references: [id])
  labId       String
  lab         LabProfile    @relation(fields: [labId], references: [id])
  testType    String
  status      LabTestStatus @default(REQUESTED)
  scheduledAt DateTime?
  fee         Decimal       @default(5000)
  createdAt   DateTime      @default(now())

  result LabResult?

  @@index([patientId])
  @@index([labId])
}

model LabResult {
  id          String    @id @default(uuid())
  labTestId   String    @unique
  labTest     LabTest   @relation(fields: [labTestId], references: [id])
  resultData  Json
  fileUrl     String?
  reviewedById String?
  reviewedBy  DoctorProfile? @relation(fields: [reviewedById], references: [id])
  uploadedAt  DateTime  @default(now())
}

// ============ AMBULANCE / EMERGENCY ============

model EmergencyRequest {
  id          String          @id @default(uuid())
  patientId   String
  patient     PatientProfile  @relation(fields: [patientId], references: [id])
  ambulanceId String?
  ambulance   AmbulanceProfile? @relation(fields: [ambulanceId], references: [id])
  lat         Float
  lng         Float
  notes       String?
  status      EmergencyStatus @default(REQUESTED)
  requestedAt DateTime        @default(now())
  completedAt DateTime?

  @@index([patientId])
  @@index([ambulanceId])
}

// ============ NURSE ============

model NurseRequest {
  id          String             @id @default(uuid())
  patientId   String
  patient     PatientProfile     @relation(fields: [patientId], references: [id])
  nurseId     String?
  nurse       NurseProfile?      @relation(fields: [nurseId], references: [id])
  serviceType String
  scheduledAt DateTime?
  status      NurseRequestStatus @default(REQUESTED)
  notes       String?
  createdAt   DateTime           @default(now())

  @@index([patientId])
  @@index([nurseId])
}

// ============ DONATIONS & INSURANCE ============

model Donation {
  id        String         @id @default(uuid())
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id])
  campaign  String
  amount    Decimal
  status    DonationStatus @default(PENDING)
  createdAt DateTime       @default(now())
}

model InsurancePolicy {
  id              String   @id @default(uuid())
  patientId       String
  patient         PatientProfile @relation(fields: [patientId], references: [id])
  provider        String
  policyNumber    String
  coverageDetails String?
  premiumAmount   Decimal?
  status          String   @default("ACTIVE")
  expiresAt       DateTime?
}

// ============ MESSAGING (cross-role) ============

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
}

// ============ PAYMENTS (shared across every module) ============

model Payment {
  id          String        @id @default(uuid())
  payerId     String
  payer       User          @relation("PayerPayments", fields: [payerId], references: [id])
  payableType PayableType
  payableId   String
  amount      Decimal
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  reference   String        @unique

  // Denormalized at creation time: the user (provider side) who is expected to
  // confirm this payment. Null for modules with no in-app counterparty
  // (donations, insurance premiums) - those auto-confirm on creation instead.
  providerUserId String?

  // Method-specific display instructions, filled in when the payment is created.
  ussdCode             String?
  transferBankName     String?
  transferAccountName  String?
  transferAccountNumber String?

  expiresAt     DateTime
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?     @relation("ConfirmedPayments", fields: [confirmedById], references: [id])

  createdAt DateTime @default(now())

  @@index([payerId])
  @@index([payableType, payableId])
}

// ============ ADMIN ============

// A lightweight trail of admin actions (suspend/reactivate a user, create/remove
// an admin, etc) so a super admin can see who did what. Kept generic (targetType
// + targetId, same pattern as Payment's payableType/payableId) rather than a
// dedicated table per action type.
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("AdminActions", fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
}
