// N-Health database schema
// Covers all 6 roles: Patient, Doctor, Pharmacy, Lab, Ambulance, Nurse

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  PHARMACY
  LAB
  AMBULANCE
  NURSE
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AppointmentType {
  IN_PERSON
  VIDEO
}

enum OrderStatus {
  PENDING
  PROCESSING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum LabTestStatus {
  REQUESTED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum EmergencyStatus {
  REQUESTED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  COMPLETED
  CANCELLED
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum NurseRequestStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProviderType {
  DOCTOR
  NURSE
  PHARMACY
  LAB
  AMBULANCE
}

enum PaymentMethod {
  USSD
  TRANSFER
  CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
  FAILED
}

// What a Payment is paying for. Kept as a loose (non-FK) reference via
// payableType + payableId since Prisma has no native polymorphic relations -
// this lets one Payment model serve every module instead of duplicating
// payment fields on Appointment, PharmacyOrder, LabTest, etc.
enum PayableType {
  APPOINTMENT
  PHARMACY_ORDER
  LAB_TEST
  NURSE_REQUEST
  DONATION
  INSURANCE_POLICY
}

// ============ CORE USER ============

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role
  name         String
  avatarUrl    String?
  isActive     Boolean  @default(true)
  // Only meaningful when role = ADMIN. A super admin can create/manage other
  // admin accounts; a regular admin cannot - this is what "super admin panel"
  // gates access to versus the plain admin views.
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile   PatientProfile?
  doctorProfile    DoctorProfile?
  pharmacyProfile  PharmacyProfile?
  labProfile       LabProfile?
  ambulanceProfile AmbulanceProfile?
  nurseProfile     NurseProfile?

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  payments         Payment[] @relation("PayerPayments")
  confirmedPayments Payment[] @relation("ConfirmedPayments")

  adminActions     AdminAuditLog[] @relation("AdminActions")

  @@index([role])
}

// ============ ROLE PROFILES ============

model PatientProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth       DateTime?
  bloodType         String?
  genotype          String?
  nhisNumber        String?
  allergies         String?
  address           String?
  emergencyContact  String?
  emergencyPhone    String?

  appointments      Appointment[]
  prescriptions     Prescription[]
  orders            PharmacyOrder[]
  labTests          LabTest[]
  emergencyRequests EmergencyRequest[]
  donations         Donation[]
  insurancePolicies InsurancePolicy[]
  nurseRequests     NurseRequest[]
}

model Specialization {
  id    String @id @default(uuid())
  name  String @unique
  type  ProviderType
  
  doctors DoctorProfile[] @relation("DoctorSpecialty")
  nurses  NurseProfile[]  @relation("NurseSpecialty")
}

model DoctorProfile {
  id                String  @id @default(uuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty         String
  specialtyId       String?
  specialty_rel     Specialization? @relation("DoctorSpecialty", fields: [specialtyId], references: [id], onDelete: SetNull)
  licenseNumber     String
  hospital          String?
  bio               String?
  consultationFee   Decimal @default(0)
  rating            Float   @default(0)
  yearsExperience   Int     @default(0)
  lat               Float?
  lng               Float?

  appointments  Appointment[]
  prescriptions Prescription[]
  reviewedLabResults LabResult[]
}

model PharmacyProfile {
  id             String @id @default(uuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacyName   String
  licenseNumber  String
  address        String?
  operatingHours String?
  lat            Float?
  lng            Float?

  inventory Inventory[]
  orders    PharmacyOrder[]
  suppliers Supplier[]
}

model LabProfile {
  id            String @id @default(uuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  labName       String
  licenseNumber String
  address       String?
  lat           Float?
  lng           Float?

  labTests LabTest[]
}

model AmbulanceProfile {
  id            String @id @default(uuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleNumber String
  licenseNumber String
  isAvailable   Boolean @default(true)
  currentLat    Float?
  currentLng    Float?

  emergencyRequests EmergencyRequest[]
}

model NurseProfile {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber String
  specialty     String?
  specialtyId   String?
  specialty_rel Specialization? @relation("NurseSpecialty", fields: [specialtyId], references: [id], onDelete: SetNull)
  hourlyRate    Decimal @default(0)
  isAvailable   Boolean @default(true)

  nurseRequests NurseRequest[]
}

// ============ APPOINTMENTS & CONSULTATIONS ============

model Appointment {
  id           String   @id @default(uuid())
  patientId    String
  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String
  doctor       DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  type         AppointmentType @default(IN_PERSON)
  status       AppointmentStatus @default(PENDING)
  scheduledAt  DateTime
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([patientId, status])
  @@index([doctorId, status])
}

model Prescription {
  id        String   @id @default(uuid())
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  medications Json  // Array of { name, dosage, frequency, durationDays }
  issuedAt  DateTime @default(now())

  @@index([patientId])
  @@index([doctorId])
}

// ============ PHARMACY ============

model Inventory {
  id         String @id @default(uuid())
  pharmacyId String
  pharmacy   PharmacyProfile @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name       String
  category   String
  stock      Int    @default(0)
  price      Decimal
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  updatedAt  DateTime @updatedAt

  @@index([pharmacyId])
  @@index([category])
}

model Supplier {
  id         String @id @default(uuid())
  pharmacyId String
  pharmacy   PharmacyProfile @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name       String
  contact    String?
  email      String?
  createdAt  DateTime @default(now())

  inventory Inventory[]

  @@index([pharmacyId])
}

model PharmacyOrder {
  id            String   @id @default(uuid())
  patientId     String
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacyId    String
  pharmacy      PharmacyProfile @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  items         Json  // Array of { inventoryId, name, qty, price }
  total         Decimal
  status        OrderStatus @default(PENDING)
  paymentStatus String  @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([patientId, status])
  @@index([pharmacyId, status])
}

// ============ LAB ============

model LabTest {
  id       String   @id @default(uuid())
  patientId String
  patient  PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  labId    String
  lab      LabProfile @relation(fields: [labId], references: [id], onDelete: Cascade)
  testType String
  status   LabTestStatus @default(REQUESTED)
  fee      Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  result LabResult?

  @@index([patientId, status])
  @@index([labId, status])
}

model LabResult {
  id         String   @id @default(uuid())
  labTestId  String   @unique
  labTest    LabTest  @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  reviewedBy String?
  doctor     DoctorProfile? @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)
  resultData Json  // { results: [{ parameter, value, unit?, referenceRange?, flag? }], notes? }
  createdAt  DateTime @default(now())
}

// ============ EMERGENCY & AMBULANCE ============

model EmergencyRequest {
  id          String   @id @default(uuid())
  patientId   String
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  ambulanceId String?
  ambulance   AmbulanceProfile? @relation(fields: [ambulanceId], references: [id], onDelete: SetNull)
  lat         Float
  lng         Float
  notes       String?
  status      EmergencyStatus @default(REQUESTED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([patientId, status])
  @@index([ambulanceId, status])
}

// ============ NURSING ============

model NurseRequest {
  id         String   @id @default(uuid())
  patientId  String
  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nurseId    String?
  nurse      NurseProfile? @relation(fields: [nurseId], references: [id], onDelete: SetNull)
  serviceType String
  scheduledAt DateTime?
  notes      String?
  status     NurseRequestStatus @default(REQUESTED)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([patientId, status])
  @@index([nurseId, status])
}

// ============ DONATIONS ============

model Donation {
  id        String   @id @default(uuid())
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  amount    Decimal
  status    DonationStatus @default(PENDING)
  createdAt DateTime @default(now())

  @@index([patientId, status])
}

// ============ INSURANCE ============

model InsurancePolicy {
  id        String   @id @default(uuid())
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider  String
  policyNumber String
  status    String  @default("ACTIVE")
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([patientId, status])
}

// ============ MESSAGING ============

model Message {
  id        String   @id @default(uuid())
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient User     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([senderId, recipientId])
}

// ============ PAYMENTS ============

model Payment {
  id            String   @id @default(uuid())
  payerId       String
  payer         User     @relation("PayerPayments", fields: [payerId], references: [id], onDelete: Cascade)
  payableType   PayableType
  payableId     String
  amount        Decimal
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  providerUserId String?
  providerConfirmedBy User? @relation("ConfirmedPayments", fields: [providerUserId], references: [id], onDelete: SetNull)
  reference     String
  expiresAt     DateTime?
  
  // USSD-specific
  ussdCode      String?
  
  // Transfer-specific
  transferBankName String?
  transferAccountName String?
  transferAccountNumber String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([payerId, status])
  @@index([payableType, payableId])
}

// ============ ADMIN ============

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
}
