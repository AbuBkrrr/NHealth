# This is a monorepo (backend/, mobile/, admin-web/) - each also has its own
# .gitignore, but this root one is a safety net in case something is ever
# added at the top level, and covers editor/OS cruft everywhere.

node_modules/
dist/
build/
.env
.env.local
*.log
.DS_Store
Thumbs.db

# Backend
backend/uploads/

# Mobile (Expo)
mobile/.expo/

# Editors
.vscode/
.idea/
