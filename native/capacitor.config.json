{
  "appId": "ng.com.nhealth.app",
  "appName": "N-Health",
  "webDir": "../apps/landing/dist",
  "backgroundColor": "#1A73E8",
  "ios": { "contentInset": "always", "scheme": "N-Health", "limitsNavigationsToAppBoundDomains": false },
  "android": { "allowMixedContent": false },
  "server": { "androidScheme": "https", "iosScheme": "capacitor" },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 800, "backgroundColor": "#1A73E8", "showSpinner": false },
    "StatusBar": { "style": "LIGHT", "backgroundColor": "#1A73E8" }
  }
}
