{
    "name": "@nhealth/mobile",
    "version": "2.0.0",
    "description": "N-Health Mobile App - React Native + Expo",
    "private": true,
    "main": "node_modules/expo/AppEntry.js",
    "scripts": {
        "start": "expo start",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "web": "expo start --web",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src --ext .ts,.tsx",
        "clean": "rm -rf .expo dist",
        "build:android": "eas build --platform android",
        "build:ios": "eas build --platform ios"
    },
    "dependencies": {
        "@nhealth/shared-types": "workspace:*",
        "@nhealth/shared-utils": "workspace:*",
        "@react-native-async-storage/async-storage": "1.23.1",
        "@react-native-community/datetimepicker": "8.0.1",
        "@react-native-community/netinfo": "11.3.1",
        "@react-navigation/bottom-tabs": "^6.6.1",
        "@react-navigation/native": "^3.8.4",
        "@react-navigation/native-stack": "^5.0.5",
        "axios": "^1.7.7",
        "expo-clipboard": "~6.0.3",
        "expo-file-system": "~17.0.1",
        "expo-image-picker": "~15.0.7",
        "expo-location": "~17.0.1",
        "expo-sharing": "~12.0.1",
        "expo-status-bar": "~1.12.1",
        "react": "18.2.0",
        "react-native": "^0.87.1",
        "react-native-safe-area-context": "4.10.5",
        "react-native-screens": "3.31.1",
        "socket.io-client": "^4.7.5"
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@nhealth/eslint-config": "workspace:*",
        "@types/node": "^22.20.2",
        "@types/react": "~18.2.79",
        "@types/react-navigation": "^3.4.0",
        "@typescript-eslint/eslint-plugin": "^7.11.0",
        "@typescript-eslint/parser": "^7.11.0",
        "eslint": "^8.57.0",
        "expo": "^46.0.21",
        "prettier": "^3.2.5",
        "typescript": "^5.5.4"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
