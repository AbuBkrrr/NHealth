{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "jsx": "react-native",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "declaration": false,
    "sourceMap": false,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@nhealth/*": ["../../packages/*/src"],
      "@/*": ["./src/*"]
    },
    "noEmit": true
  },
  "include": ["src", "App.tsx"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
