  status      String    @default("PENDING") // PENDING | COMPLETED | CANCELLED
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

// Who viewed / changed which patient's medical data (NDPR / GDPR / HIPAA-style accountability).
model AccessLog {
  id        String   @id @default(uuid())
  actorId   String
  actor     User     @relation("AccessActor", fields: [actorId], references: [id], onDelete: Cascade)
  subjectId String
  subject   User     @relation("AccessSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  resource  String
  action    String
  ip        String?
  createdAt DateTime @default(now())

  @@index([subjectId, createdAt])
}

model CurrencyRate {
  code      String   @id // "USD"
  perNgn    Decimal  @db.Decimal(18, 8) // units of this currency per 1 NGN
  updatedAt DateTime @updatedAt
}

// ============================================================
// PROVIDER EARNINGS & PAYOUTS (Bolt-style driver settlement)
// - In-app payments: platform collects, provider earns gross - commission when the service completes.
// - Cash payments: provider collects; the platform commission becomes a debt on the provider balance.
// - Balance = sum(entries). Positive is paid out on the payout schedule; negative must be settled
//   (netted automatically from future in-app earnings, or paid by the provider).
// ============================================================

model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model ProviderLedgerEntry {
  id             String   @id @default(uuid())
  providerUserId String
  provider       User     @relation(fields: [providerUserId], references: [id], onDelete: Cascade)
  // EARNING | COMMISSION | CASH_COMMISSION | PAYOUT | PAYOUT_REVERSAL | SETTLEMENT | ADJUSTMENT | REFUND_CLAWBACK | ESCROW_SETTLED
  type           String
  amount         Decimal  @db.Decimal(12, 2) // + owed to provider, - owed to platform
  method         String // IN_APP | CASH | ESCROW | PAYOUT | MANUAL
  sourceType     String? // APPOINTMENT | PHARMACY_ORDER | LAB_TEST | NURSE_REQUEST | EMERGENCY | POS_SALE
  sourceId       String?
  gross          Decimal? @db.Decimal(12, 2)
  commissionRate Decimal? @db.Decimal(5, 2)
  payoutId       String?
  description    String
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([providerUserId, type, sourceType, sourceId])
  @@index([providerUserId, createdAt])
  @@index([payoutId])
}

model Payout {
  id             String    @id @default(uuid())
  providerUserId String
  provider       User      @relation(fields: [providerUserId], references: [id], onDelete: Cascade)
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("NGN")
  // PENDING | PROCESSING | PAID | FAILED | REVERSED | MANUAL
  status         String    @default("PENDING")
  gateway        String // paystack | flutterwave | manual
  reference      String    @unique
  transferCode   String?
  bankName       String
  bankCode       String
  accountNumber  String
  accountName    String
  failureReason  String?
  initiatedById  String?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([providerUserId, createdAt])
  @@index([status])
}
