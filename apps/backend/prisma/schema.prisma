// N-Health database schema
// Covers all 6 roles: Patient, Doctor, Pharmacy, Lab, Ambulance, Nurse

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  PHARMACY
  LAB
  AMBULANCE
  NURSE
  INSTITUTION
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AppointmentType {
  IN_PERSON
  VIDEO
}

enum OrderStatus {
  PENDING
  PROCESSING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum LabTestStatus {
  REQUESTED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum EmergencyStatus {
  REQUESTED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  COMPLETED
  CANCELLED
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum NurseRequestStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProviderType {
  DOCTOR
  NURSE
  PHARMACY
  LAB
  AMBULANCE
  INSTITUTION
}

enum PaymentMethod {
  USSD
  TRANSFER
  CARD
  WALLET
  CASH
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
  FAILED
}

// What a Payment is paying for. Kept as a loose (non-FK) reference via
// payableType + payableId since Prisma has no native polymorphic relations -
// this lets one Payment model serve every module instead of duplicating
// payment fields on Appointment, PharmacyOrder, LabTest, etc.
enum PayableType {
  APPOINTMENT
  PHARMACY_ORDER
  LAB_TEST
  NURSE_REQUEST
  DONATION
  INSURANCE_POLICY
  EMERGENCY
  POS_SALE
}

// ============ CORE USER ============

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role
  name         String
  avatarUrl    String?
  isActive     Boolean  @default(true)
  // Only meaningful when role = ADMIN. A super admin can create/manage other
  // admin accounts; a regular admin cannot - this is what "super admin panel"
  // gates access to versus the plain admin views.
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile   PatientProfile?
  doctorProfile    DoctorProfile?
  pharmacyProfile  PharmacyProfile?
  labProfile       LabProfile?
  ambulanceProfile AmbulanceProfile?
  nurseProfile     NurseProfile?

  sentMessages      Message[]       @relation("SentMessages")
  receivedMessages  Message[]       @relation("ReceivedMessages")
  supportTickets    SupportTicket[]
  payments          Payment[]       @relation("PayerPayments")
  confirmedPayments Payment[]       @relation("ConfirmedPayments")

  adminActions AdminAuditLog[] @relation("AdminActions")

  // N-Health Credits
  creditLedger       CreditLedger?
  creditTransactions CreditTransaction[]

  // Payment gateway logs
  paymentGatewayLogs PaymentGatewayLog[]

  // Escrow
  escrowTransactions EscrowTransaction[]
  escrowAsProvider   EscrowTransaction[] @relation("ProviderEscrows")
  bankAccounts       BankAccount[]

  // ---- Global / compliance ----
  country            String               @default("NG")
  currency           String               @default("NGN")
  locale             String               @default("en")
  timezone           String               @default("Africa/Lagos")
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  kycStatus          KycStatus            @default(NOT_STARTED)
  verificationStatus ProviderVerification @default(UNVERIFIED)
  verificationNote   String?
  verifiedAt         DateTime?
  failedLogins       Int                  @default(0)
  lockedUntil        DateTime?
  tokenVersion       Int                  @default(0)
  lastLoginAt        DateTime?
  termsAcceptedAt    DateTime?
  privacyAcceptedAt  DateTime?
  marketingOptIn     Boolean              @default(false)
  referralCode       String?              @unique
  referredById       String?
  deletedAt          DateTime?
  notificationPrefs  Json?

  institutionProfile  InstitutionProfile?
  kycVerifications    KycVerification[]
  providerDocuments   ProviderDocument[]
  otpCodes            OtpCode[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  availabilityRules   AvailabilityRule[]
  availabilityBlocks  AvailabilityBlock[]
  reviewsGiven        Review[]                @relation("ReviewAuthor")
  reviewsReceived     Review[]                @relation("ReviewTarget")
  reminders           MedicationReminder[]
  familyMembers       FamilyMember[]
  vaccinations        Vaccination[]
  healthDocuments     HealthDocument[]
  campaignsOrganized  DonationCampaign[]
  donorPledges        DonorPledge[]
  organRegistration   OrganDonorRegistration?
  dataRequests        DataRequest[]
  accessLogsAsActor   AccessLog[]             @relation("AccessActor")
  accessLogsAsSubject AccessLog[]             @relation("AccessSubject")
  staffMemberships    InstitutionStaff[]
  institutionPatients InstitutionPatient[]
  referralsSent       Referral[]              @relation("ReferralFrom")
  referralsReceived   Referral[]              @relation("ReferralTo")
  posSales            PosSale[]
  ledgerEntries       ProviderLedgerEntry[]
  payouts             Payout[]

  @@index([role])
}

// ============ ROLE PROFILES ============

model PatientProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth      DateTime?
  bloodType        String?
  genotype         String?
  nhisNumber       String?
  allergies        String?
  address          String?
  emergencyContact String?
  emergencyPhone   String?

  appointments      Appointment[]
  prescriptions     Prescription[]
  orders            PharmacyOrder[]
  labTests          LabTest[]
  emergencyRequests EmergencyRequest[]
  donations         Donation[]
  insurancePolicies InsurancePolicy[]
  nurseRequests     NurseRequest[]
  height            Float?
  weight            Float?
  bloodTypeChanges  Int                @default(0)
  genotypeChanges   Int                @default(0)

  gender                String?
  maritalStatus         String?
  occupation            String?
  city                  String?
  state                 String?
  country               String?
  nationalIdType        String?
  nationalIdLast4       String?
  chronicConditions     String?
  currentMedications    String?
  disabilities          String?
  surgeries             String?
  familyHistory         String?
  smoker                Boolean?
  alcohol               String?
  emergencyCardToken    String?   @unique
  isBloodDonor          Boolean   @default(false)
  lastBloodDonationAt   DateTime?
  insuranceShareConsent Boolean   @default(false)
}

model DoctorProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty       String
  licenseNumber   String
  hospital        String?
  bio             String?
  consultationFee Decimal @default(0)
  rating          Float   @default(0)
  yearsExperience Int     @default(0)
  lat             Float?
  lng             Float?

  appointments       Appointment[]
  prescriptions      Prescription[]
  reviewedLabResults LabResult[]

  institutionId  String?
  institution    InstitutionProfile? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  languages      String?
  qualifications String?
  city           String?
  state          String?
  country        String?
  reviewCount    Int                 @default(0)
  slotMinutes    Int                 @default(30)
  homeVisit      Boolean             @default(false)
}

model PharmacyProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacyName   String
  licenseNumber  String
  address        String?
  operatingHours String?
  lat            Float?
  lng            Float?

  inventory Inventory[]
  orders    PharmacyOrder[]
  suppliers Supplier[]

  phone        String?
  city         String?
  state        String?
  country      String?
  rating       Float   @default(0)
  reviewCount  Int     @default(0)
  homeDelivery Boolean @default(false)

  stockIntakes        StockIntake[]
  stockAudits         StockAudit[]
  posSales            PosSale[]
  prescriptionsRouted Prescription[] @relation("RoutedPrescriptions")
}

model LabProfile {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  labName       String
  licenseNumber String
  address       String?
  lat           Float?
  lng           Float?

  labTests LabTest[]

  phone        String?
  city         String?
  state        String?
  country      String?
  rating       Float   @default(0)
  reviewCount  Int     @default(0)
  homeDelivery Boolean @default(false)

  operatingHours String?
  homeCollection Boolean          @default(false)
  catalog        LabTestCatalog[]
}

model AmbulanceProfile {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleNumber String
  licenseNumber String
  currentLat    Float?
  currentLng    Float?
  isAvailable   Boolean @default(true)

  emergencyRequests EmergencyRequest[]

  operatorName   String?
  vehicleType    String?
  baseFee        Decimal   @default(0)
  phone          String?
  lastLocationAt DateTime?
  rating         Float     @default(0)
}

model NurseProfile {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber String
  specialty     String?
  hourlyRate    Decimal @default(0)
  isAvailable   Boolean @default(true)

  nurseRequests NurseRequest[]

  city            String?
  state           String?
  yearsExperience Int     @default(0)
  bio             String?
  rating          Float   @default(0)
  reviewCount     Int     @default(0)
  lat             Float?
  lng             Float?
}

// ============ SPECIALIZATIONS ============

model Specialization {
  id       String       @id @default(uuid())
  name     String       @unique
  desc     String
  category String // "Cardiology", "Surgery", "General Nursing", etc.
  type     ProviderType // "DOCTOR" or "NURSE"
}

// ============ APPOINTMENTS & PRESCRIPTIONS ============

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  patient     PatientProfile    @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      DoctorProfile     @relation(fields: [doctorId], references: [id])
  scheduledAt DateTime
  type        AppointmentType   @default(IN_PERSON)
  status      AppointmentStatus @default(PENDING)
  reason      String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  durationMin       Int       @default(30)
  fee               Decimal   @default(0)
  serviceFee        Decimal   @default(0)
  currency          String    @default("NGN")
  paymentStatus     String    @default("UNPAID")
  cancelReason      String?
  cancelledBy       String?
  rescheduledFromId String?
  institutionId     String?
  diagnosis         String?
  followUpAt        DateTime?
  reminderSentAt    DateTime?

  @@index([patientId])
  @@index([doctorId])
}

model Prescription {
  id          String          @id @default(uuid())
  patientId   String
  patient     PatientProfile  @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      DoctorProfile   @relation(fields: [doctorId], references: [id])
  medications Json // [{ name, dosage, frequency, durationDays }]
  status      String          @default("ACTIVE")
  issuedAt    DateTime        @default(now())
  orders      PharmacyOrder[]

  pharmacyId    String?
  pharmacy      PharmacyProfile? @relation("RoutedPrescriptions", fields: [pharmacyId], references: [id], onDelete: SetNull)
  notes         String?
  appointmentId String?
}

// ============ PHARMACY ============

model Inventory {
  id         String          @id @default(uuid())
  pharmacyId String
  pharmacy   PharmacyProfile @relation(fields: [pharmacyId], references: [id])
  name       String
  category   String?
  stock      Int             @default(0)
  price      Decimal
  expiryDate DateTime?
  supplierId String?
  supplier   Supplier?       @relation(fields: [supplierId], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  brand                String?
  manufacturer         String?
  batchNumber          String?
  barcode              String?
  unit                 String?
  costPrice            Decimal?
  reorderLevel         Int      @default(10)
  requiresPrescription Boolean  @default(false)
  description          String?

  @@index([pharmacyId])
}

model Supplier {
  id         String          @id @default(uuid())
  pharmacyId String
  pharmacy   PharmacyProfile @relation(fields: [pharmacyId], references: [id])
  name       String
  contact    String?
  email      String?

  items Inventory[]
}

model PharmacyOrder {
  id             String          @id @default(uuid())
  patientId      String
  patient        PatientProfile  @relation(fields: [patientId], references: [id])
  pharmacyId     String
  pharmacy       PharmacyProfile @relation(fields: [pharmacyId], references: [id])
  prescriptionId String?
  prescription   Prescription?   @relation(fields: [prescriptionId], references: [id])
  items          Json // [{ inventoryId, name, qty, price }]
  total          Decimal
  status         OrderStatus     @default(PENDING)
  paymentStatus  String          @default("PENDING")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  currency        String  @default("NGN")
  deliveryMethod  String  @default("PICKUP")
  deliveryAddress String?
  declineReason   String?

  @@index([patientId])
  @@index([pharmacyId])
}

// ============ LAB ============

model LabTest {
  id          String         @id @default(uuid())
  patientId   String
  patient     PatientProfile @relation(fields: [patientId], references: [id])
  labId       String
  lab         LabProfile     @relation(fields: [labId], references: [id])
  testType    String
  status      LabTestStatus  @default(REQUESTED)
  scheduledAt DateTime?
  fee         Decimal        @default(5000)
  createdAt   DateTime       @default(now())

  result LabResult?

  catalogId           String?
  requestedByDoctorId String?
  notes               String?
  homeCollection      Boolean @default(false)
  address             String?
  currency            String  @default("NGN")
  paymentStatus       String  @default("UNPAID")

  @@index([patientId])
  @@index([labId])
}

model LabResult {
  id           String         @id @default(uuid())
  labTestId    String         @unique
  labTest      LabTest        @relation(fields: [labTestId], references: [id])
  resultData   Json
  fileUrl      String?
  reviewedById String?
  reviewedBy   DoctorProfile? @relation(fields: [reviewedById], references: [id])
  uploadedAt   DateTime       @default(now())
}

// ============ AMBULANCE / EMERGENCY ============

model EmergencyRequest {
  id          String            @id @default(uuid())
  patientId   String
  patient     PatientProfile    @relation(fields: [patientId], references: [id])
  ambulanceId String?
  ambulance   AmbulanceProfile? @relation(fields: [ambulanceId], references: [id])
  lat         Float
  lng         Float
  notes       String?
  status      EmergencyStatus   @default(REQUESTED)
  requestedAt DateTime          @default(now())
  completedAt DateTime?

  type         String    @default("MEDICAL")
  contactPhone String?
  doctorUserId String?
  etaMinutes   Int?
  acceptedAt   DateTime?
  arrivedAt    DateTime?
  address      String?

  @@index([patientId])
  @@index([ambulanceId])
}

// ============ NURSE ============

model NurseRequest {
  id          String             @id @default(uuid())
  patientId   String
  patient     PatientProfile     @relation(fields: [patientId], references: [id])
  nurseId     String?
  nurse       NurseProfile?      @relation(fields: [nurseId], references: [id])
  serviceType String
  scheduledAt DateTime?
  status      NurseRequestStatus @default(REQUESTED)
  notes       String?
  createdAt   DateTime           @default(now())

  address       String?
  durationHours Int     @default(1)
  fee           Decimal @default(0)

  @@index([patientId])
  @@index([nurseId])
}

// ============ DONATIONS & INSURANCE ============

model Donation {
  id        String         @id @default(uuid())
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id])
  campaign  String
  amount    Decimal
  status    DonationStatus @default(PENDING)
  createdAt DateTime       @default(now())

  campaignId  String?
  campaignRef DonationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  anonymous   Boolean           @default(false)
  message     String?
  currency    String            @default("NGN")
  reference   String?           @unique
}

model InsurancePolicy {
  id              String         @id @default(uuid())
  patientId       String
  patient         PatientProfile @relation(fields: [patientId], references: [id])
  provider        String
  policyNumber    String
  coverageDetails String?
  premiumAmount   Decimal?
  status          String         @default("ACTIVE")
  expiresAt       DateTime?

  planId      String?
  plan        InsurancePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  memberCount Int            @default(1)
  startedAt   DateTime?
  createdAt   DateTime       @default(now())
}

// ============ MESSAGING (cross-role) ============

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  attachments Json?
  readAt      DateTime?

  @@index([senderId])
  @@index([receiverId])
}

// ============ PAYMENTS (shared across every module) ============

model Payment {
  id          String        @id @default(uuid())
  payerId     String
  payer       User          @relation("PayerPayments", fields: [payerId], references: [id])
  payableType PayableType
  payableId   String
  amount      Decimal
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  reference   String        @unique

  // Denormalized at creation time: the user (provider side) who is expected to
  // confirm this payment. Null for modules with no in-app counterparty
  // (donations, insurance premiums) - those auto-confirm on creation instead.
  providerUserId String?

  // Method-specific display instructions, filled in when the payment is created.
  ussdCode              String?
  transferBankName      String?
  transferAccountName   String?
  transferAccountNumber String?

  expiresAt     DateTime
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?     @relation("ConfirmedPayments", fields: [confirmedById], references: [id])

  createdAt DateTime @default(now())

  @@index([payerId])
  @@index([payableType, payableId])
}

// ============ ADMIN ============

model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("AdminActions", fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
}

// ============================================================
// SUPPORT TICKETS
// ============================================================
model SupportTicket {
  id          String    @id @default(uuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String
  userEmail   String
  subject     String
  category    String
  message     String    @db.Text
  priority    String    @default("normal")
  status      String    @default("open")
  adminReply  String?   @db.Text
  repliedById String?
  repliedAt   DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

// ============================================================
// N-HEALTH CREDITS
// Closed-loop prepaid instrument — NOT a wallet, NOT e-money.
// Redeemable only for healthcare services on the N-Health platform.
// Not transferable between users. Not cashable.
// ============================================================

model CreditLedger {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Running balance. Derived from sum of transactions but cached for fast reads.
  balance Decimal @default(0) @db.Decimal(12, 2)

  lastTransactionId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions CreditTransaction[]

  @@index([userId])
}

model CreditTransaction {
  id       String       @id @default(uuid())
  ledgerId String
  ledger   CreditLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // purchase | spend | refund | expiry | adjustment
  type String

  // Positive for purchase/refund, negative for spend/expiry
  amount Decimal @db.Decimal(12, 2)

  // Running balance after this transaction
  balanceAfter Decimal @db.Decimal(12, 2)

  description String
  reference   String @unique // our internal ref, e.g. CR-xxx, ORD-xxx, APT-xxx
  metadata    Json? // gateway, orderId, appointmentId, etc.

  // pending | completed | failed | reversed
  status String @default("completed")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([ledgerId])
  @@index([type])
  @@index([reference])
  @@index([createdAt])
}

// ============================================================
// PAYMENT GATEWAY LOGS
// One log per payment attempt across any gateway.
// ============================================================

model PaymentGatewayLog {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // fincra | monnify | flutterwave | payscrow
  gateway String

  // Gateway's reference (their transaction ID)
  gatewayRef String

  // Our internal reference (unique)
  internalRef String @unique

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("NGN")

  // pending | success | failed | abandoned
  status String

  // credit_purchase | appointment | pharmacy | lab | escrow_release
  purpose String

  requestPayload  Json?
  responsePayload Json?
  webhookPayload  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([gateway])
  @@index([status])
  @@index([internalRef])
  @@index([gatewayRef])
}

// ============================================================
// ESCROW (via PayScrow)
// Holds funds for high-value services until delivery is confirmed.
// ============================================================

model EscrowTransaction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Provider receiving the funds
  providerUserId String?
  provider       User?   @relation("ProviderEscrows", fields: [providerUserId], references: [id], onDelete: SetNull)
  purpose        String // appointment | pharmacy | lab | nurse | emergency
  purposeId      String // appointment ID, order ID, etc.

  // PayScrow references
  externalReference     String  @unique
  payscrowRef           String  @unique // transactionNumber (MKT-xxxx)
  payscrowTransactionId String? // GUID for apply-code endpoint
  paymentLink           String? // customer checkout URL
  escrowCode            String? // released only after payment

  // Amounts
  currency       String  @default("NGN")
  amount         Decimal @db.Decimal(12, 2) // gross item total
  merchantCharge Decimal @default(0) @db.Decimal(12, 2)
  customerCharge Decimal @default(0) @db.Decimal(12, 2)
  totalPayable   Decimal @default(0) @db.Decimal(12, 2)
  netSettlement  Decimal @default(0) @db.Decimal(12, 2)

  // Status
  status String // pending | in_escrow | completed | released | disputed | refunded | terminated

  fundedAt     DateTime?
  releasedAt   DateTime?
  disputedAt   DateTime?
  terminatedAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([providerUserId])
  @@index([status])
  @@index([purposeId])
  @@index([payscrowRef])
}

// ============================================================
// BANK ACCOUNTS (provider payouts)
// ============================================================
model BankAccount {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bankCode      String // CBN bank code e.g. "058"
  bankName      String // Display name e.g. "GTBank"
  accountNumber String // 10 digits
  accountName   String

  isPrimary  Boolean @default(true)
  isVerified Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // Paystack transfer recipient (created once the account is resolved/verified)
  recipientCode String?
  verifiedName  String?

  @@unique([userId, accountNumber])
  @@index([userId])
}

// ============================================================
// GLOBAL-READINESS, TRUST & SAFETY, AND EXTENDED FEATURES
// ============================================================

enum KycStatus {
  NOT_STARTED
  PENDING
  IN_REVIEW
  APPROVED
  DECLINED
  EXPIRED
}

enum ProviderVerification {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

// Identity verification sessions run through Didit (ID documents + liveness).
model KycVerification {
  id              String   @id @default(uuid())
  userId          String
