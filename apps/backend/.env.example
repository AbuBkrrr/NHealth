PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nhealth?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
# Base URL the server is reachable at - used to build absolute avatarUrl links.
# When testing on a physical device/emulator, set this to your machine's LAN IP, e.g.
# PUBLIC_URL=http://192.168.1.20:4000
PUBLIC_URL=http://localhost:4000
