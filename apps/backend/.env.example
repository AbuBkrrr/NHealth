# ---------------- Core ----------------
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nhealth?schema=public"
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN=7d
# Comma-separated extra allowed web origins (the nhealth.com.ng domains and localhost are always allowed). Never "*" in production.
CORS_ORIGIN=https://app.example.com
# Public URL of this API (used for local-disk upload links in development)
PUBLIC_URL=http://localhost:4000
# Public URL of the web app (payment & KYC return links, emails)
APP_URL=https://www.nhealth.com.ng

# ---------------- Email (Resend) ----------------
RESEND_API_KEY=
EMAIL_FROM="N-Health <no-reply@nhealth.com.ng>"

# ---------------- WhatsApp (no SMS) ----------------
# WhatsApp Business (Meta Cloud API): verification codes, alerts, reminders and opted-in news.
# N-Health sends no SMS. Templates must be approved in WhatsApp Manager - see docs/WHATSAPP.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_OTP=nhealth_code
WHATSAPP_TEMPLATE_UPDATE=nhealth_update
WHATSAPP_TEMPLATE_NEWS=nhealth_news
WHATSAPP_TEMPLATE_LANG=en

# ---------------- File storage (Cloudinary) ----------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------- Payments ----------------
# Card payments split straight to providers' accounts, provider debt settlement and payouts (Paystack/Flutterwave).
# Enabled when the secret key is present.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Optional legacy gateways (off unless set)
FINCRA_SECRET_KEY=
FINCRA_WEBHOOK_SECRET=
MONNIFY_SECRET_KEY=
# Escrow (PayScrow)
PAYSCROW_API_KEY=
PAYSCROW_BASE_URL=
PAYSCROW_WEBHOOK_SECRET=

# N-Health's own bank account: receives the platform commission + booking fee from PayScrow escrow settlements.
# (Card payments split automatically: providers' shares go to their Paystack/Flutterwave subaccounts, the rest stays in your main account.)
PLATFORM_BANK_CODE=
PLATFORM_ACCOUNT_NUMBER=
PLATFORM_ACCOUNT_NAME=N-Health

# ---------------- Identity verification (Didit) ----------------
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
# Workflow for patients (ID document + liveness)
DIDIT_WORKFLOW_ID=
# Optional stricter workflow for providers/institutions (falls back to DIDIT_WORKFLOW_ID)
DIDIT_PROVIDER_WORKFLOW_ID=
DIDIT_BASE_URL=https://verification.didit.me

# ---------------- Web push ----------------
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------- Google sign-in ----------------
GOOGLE_CLIENT_ID=

# ---------------- Business rules ----------------
# Initial defaults only - commission per service, booking fee, cash policy and the payout schedule
# are managed by super admins in Admin → Fees & payouts (stored in the database).
SERVICE_FEE_PERCENT=5
POS_TAX_PERCENT=5
# Coins are free rewards only. Selling coins is stored value (CBN): keep this false unless you have a licensed partner.
COIN_TOPUP_ENABLED=false
# Reward coins: what N-Health pays a provider for each coin a patient uses (coins are never sold)
COIN_VALUE_NGN=10
# Coins earned by an inviter when the person they invited confirms their email or phone
INVITE_REWARD_COINS=1
# Enforce licence verification before providers can act (defaults to on in production)
# REQUIRE_PROVIDER_VERIFICATION=1
# Set to 1 on all but one instance when running multiple API replicas
# SCHEDULER_DISABLED=1

# Your company (shown on the privacy policy and terms; the NDPA requires the data controller's identity)
COMPANY_LEGAL_NAME=
COMPANY_RC_NUMBER=
COMPANY_ADDRESS=
DPO_EMAIL=privacy@nhealth.com.ng
SUPPORT_EMAIL=support@nhealth.com.ng
