# ---------------- Core ----------------
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nhealth?schema=public"
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN=7d
# Comma-separated extra allowed web origins (the nhealth.com.ng domains and localhost are always allowed). Never "*" in production.
CORS_ORIGIN=https://app.example.com
# Public URL of this API (used for local-disk upload links in development)
PUBLIC_URL=http://localhost:4000
# Public URL of the web app (payment & KYC return links, emails)
APP_URL=https://www.nhealth.com.ng

# ---------------- Email (Resend) ----------------
RESEND_API_KEY=
EMAIL_FROM="N-Health <no-reply@nhealth.com.ng>"

# ---------------- SMS / OTP (Termii) ----------------
TERMII_API_KEY=
TERMII_SENDER_ID=N-Health
TERMII_BASE_URL=https://api.ng.termii.com

# ---------------- File storage (Cloudinary) ----------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------- Payments ----------------
# Coins top-up gateways (enabled when the secret key is present)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Optional legacy gateways (off unless set)
FINCRA_SECRET_KEY=
FINCRA_WEBHOOK_SECRET=
MONNIFY_SECRET_KEY=
# Escrow (PayScrow)
PAYSCROW_API_KEY=
PAYSCROW_BASE_URL=
PAYSCROW_WEBHOOK_SECRET=

# ---------------- Identity verification (Didit) ----------------
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
# Workflow for patients (ID document + liveness)
DIDIT_WORKFLOW_ID=
# Optional stricter workflow for providers/institutions (falls back to DIDIT_WORKFLOW_ID)
DIDIT_PROVIDER_WORKFLOW_ID=
DIDIT_BASE_URL=https://verification.didit.me

# ---------------- Web push ----------------
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------- Google sign-in ----------------
GOOGLE_CLIENT_ID=

# ---------------- Business rules ----------------
SERVICE_FEE_PERCENT=5
POS_TAX_PERCENT=5
EMERGENCY_MIN_BALANCE=5000
REFERRAL_REWARD=500
# Enforce licence verification before providers can act (defaults to on in production)
# REQUIRE_PROVIDER_VERIFICATION=1
# Set to 1 on all but one instance when running multiple API replicas
# SCHEDULER_DISABLED=1
