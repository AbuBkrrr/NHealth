{
  "name": "@nhealth/backend",
  "version": "2.0.0",
  "description": "N-Health backend API - Express + Prisma + Socket.io",
  "private": true,
  "main": "dist/apps/backend/src/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "node ../../node_modules/typescript/lib/tsc.js -p ../../packages/shared-types && node ../../node_modules/typescript/lib/tsc.js -p ../../packages/shared-utils && node --stack-size=16384 ../../node_modules/typescript/lib/tsc.js",
    "start": "node scripts/migrate.cjs && node dist/apps/backend/src/server.js",
    "start:migrate": "prisma migrate deploy && node dist/apps/backend/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "start:nomigrate": "node dist/apps/backend/src/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@nhealth/shared-types": "workspace:*",
    "@nhealth/shared-utils": "workspace:*",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "7.4.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.1.0",
    "pino-pretty": "^10.3.1",
    "prisma": "^5.22.0",
    "socket.io": "^4.7.5",
    "web-push": "3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nhealth/eslint-config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/supertest": "6.0.2",
    "@types/web-push": "3.6.4",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.4",
    "supertest": "7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "2.1.4"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
