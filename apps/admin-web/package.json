{
    "name":  "@nhealth/admin-web",
    "version":  "2.0.0",
    "description":  "N-Health Admin Dashboard - React + Vite",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "preview":  "vite preview",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "eslint src --ext .ts,.tsx",
                    "clean":  "rm -rf dist",
                    "format":  "prettier --write src"
                },
    "dependencies":  {
                         "@nhealth/shared-types":  "workspace:*",
                         "@nhealth/shared-utils":  "workspace:*",
                         "axios":  "^1.7.7",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "react-router-dom":  "^6.26.2"
                     },
    "devDependencies":  {
                            "@nhealth/eslint-config":  "workspace:*",
                            "@types/node":  "^20.14.0",
                            "@types/react":  "^18.3.5",
                            "@types/react-dom":  "^18.3.0",
                            "@vitejs/plugin-react":  "^4.3.1",
                            "@typescript-eslint/eslint-plugin":  "^7.11.0",
                            "@typescript-eslint/parser":  "^7.11.0",
                            "eslint":  "^8.57.0",
                            "eslint-plugin-react":  "^7.34.2",
                            "eslint-plugin-react-hooks":  "^4.6.2",
                            "prettier":  "^3.2.5",
                            "typescript":  "^5.5.4",
                            "vite":  "^5.4.6"
                        },
    "allowScripts":  {
                         "esbuild@0.21.5":  true
                     }
}
