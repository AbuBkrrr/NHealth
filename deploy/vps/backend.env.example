# N-Health API settings on the VPS.  Edit with:  nano /etc/nhealth/backend.env
# Then apply with:                              systemctl restart nhealth-api
# Lines left empty switch that integration off. Full reference: apps/backend/.env.example

NODE_ENV=production
PORT=4000
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
PUBLIC_URL=
APP_URL=
CORS_ORIGIN=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=N-Health <no-reply@nhealth.com.ng>

# WhatsApp Business (Meta Cloud API): verification codes, alerts, reminders and opted-in news.
# N-Health sends no SMS. Templates must be approved in WhatsApp Manager - see docs/WHATSAPP.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_OTP=nhealth_code
WHATSAPP_TEMPLATE_UPDATE=nhealth_update
WHATSAPP_TEMPLATE_NEWS=nhealth_news
WHATSAPP_TEMPLATE_LANG=en

# Payments - Paystack & Flutterwave (split card payments straight to providers, payouts)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Escrow (PayScrow)
PAYSCROW_API_KEY=
PAYSCROW_WEBHOOK_SECRET=

# N-Health's own bank account (receives commission from escrow settlements)
PLATFORM_BANK_CODE=
PLATFORM_ACCOUNT_NUMBER=
PLATFORM_ACCOUNT_NAME=N-Health

# Identity verification (Didit v3)
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
DIDIT_PROVIDER_WORKFLOW_ID=
DIDIT_BASE_URL=https://verification.didit.me

# Files: optional on a VPS (uploads are stored on this server's disk and included in backups).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web push (generated automatically by the installer)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google sign-in (optional)
GOOGLE_CLIENT_ID=

# Your company (shown on the privacy policy and terms; the NDPA requires the data controller's identity)
COMPANY_LEGAL_NAME=
COMPANY_RC_NUMBER=
COMPANY_ADDRESS=
DPO_EMAIL=privacy@nhealth.com.ng
SUPPORT_EMAIL=support@nhealth.com.ng
