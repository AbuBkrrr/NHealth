[Unit]
Description=N-Health API
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__APP_DIR__/apps/backend
EnvironmentFile=__ENV_FILE__
Environment=NODE_OPTIONS=--max-old-space-size=384
# Never take more than this much memory from the server (it shares the server with other apps)
MemoryHigh=450M
MemoryMax=650M
Environment=HOME=/tmp
Environment=PATH=__NODE_DIR__/bin:/usr/bin:/bin
Environment=npm_config_cache=/tmp/.npm
# Applies pending database migrations (safe, idempotent) before every start.
ExecStartPre=__NODE_DIR__/bin/node scripts/migrate.cjs
ExecStart=__NODE_DIR__/bin/node dist/apps/backend/src/server.js
Restart=always
RestartSec=5
TimeoutStartSec=300
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__APP_DIR__/apps/backend/uploads

[Install]
WantedBy=multi-user.target
