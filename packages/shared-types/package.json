{
    "name":  "@nhealth/shared-types",
    "version":  "1.0.0",
    "description":  "Shared TypeScript types and zod schemas for N-Health",
    "main":  "./src/index.ts",
    "types":  "./src/index.ts",
    "exports":  {
                    ".":  {
                              "types":  "./src/index.ts",
                              "default":  "./src/index.ts"
                          }
                },
    "scripts":  {
                    "build":  "tsc",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "eslint src --ext .ts",
                    "clean":  "rm -rf dist"
                },
    "dependencies":  {
                         "zod":  "^3.23.8"
                     },
    "devDependencies":  {
                            "@typescript-eslint/eslint-plugin":  "7.18.0",
                            "@typescript-eslint/parser":  "7.18.0",
                            "eslint":  "8.57.0",
                            "typescript":  "^5.5.4"
                        },
    "publishConfig":  {
                          "main":  "./dist/index.js",
                          "types":  "./dist/index.d.ts",
                          "exports":  {
                                          ".":  {
                                                    "types":  "./dist/index.d.ts",
                                                    "default":  "./dist/index.js"
                                                }
                                      }
                      }
}
