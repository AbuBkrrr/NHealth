{
    "name":  "@nhealth/shared-utils",
    "version":  "1.0.0",
    "description":  "Shared utilities for N-Health",
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "default":  "./dist/index.js"
                          },
                    "./jwt":  {
                                  "types":  "./dist/jwt.d.ts",
                                  "default":  "./dist/jwt.js"
                              },
                    "./logger":  {
                                     "types":  "./dist/logger.d.ts",
                                     "default":  "./dist/logger.js"
                                 },
                    "./errors":  {
                                     "types":  "./dist/errors.d.ts",
                                     "default":  "./dist/errors.js"
                                 }
                },
    "scripts":  {
                    "build":  "tsc",
                    "typecheck":  "tsc --noEmit",
                    "clean":  "rm -rf dist",
                    "lint":  "eslint src --ext .ts"
                },
    "dependencies":  {
                         "jsonwebtoken":  "^9.0.2",
                         "pino":  "^9.1.0"
                     },
    "devDependencies":  {
                            "@types/jsonwebtoken":  "^9.0.6",
                            "@types/node":  "^20.14.0",
                            "@typescript-eslint/eslint-plugin":  "7.18.0",
                            "@typescript-eslint/parser":  "7.18.0",
                            "eslint":  "8.57.0",
                            "typescript":  "^5.5.4"
                        }
}
